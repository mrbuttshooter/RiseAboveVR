  m_Script: {fileID: 11500000, guid: a7591795ef533804cb362a3d6a97d079, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AcrophobiaVR.LevelController
  levelIndex: 1
  levelTitle: Level 2 - The Construction Site
  startPoint: {fileID: 1036915438}
  boardPoint: {fileID: 1677659022}
  objectives:
  - {fileID: 2088387093}
  - {fileID: 2016325776}
  - {fileID: 2080183542}
  - {fileID: 1105123241}
  introLines:
  - 'This is the Skyline Tower construction site! Our job: plant the topping-out
    flag at the end of the crane.'
  - First, the open lift to the roof. It's slow and steady... mostly.
  - Three tools were left up there - grab them on the way. Then a plank, a ladder
    and the crane.
  finishLine: Incredible! You rode a crane beam across the sky. Level two complete!
  baseFogDensity: 1
  onFinale:
    m_PersistentCalls:
      m_Calls: []
  finaleSeconds: 0
