  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AcrophobiaVR.LevelController
  levelIndex: 2
  levelTitle: Level 3 - The Skyscraper
  startPoint: {fileID: 85417347}
  boardPoint: {fileID: 64578936}
  objectives:
  - {fileID: 319011654}
  - {fileID: 255913677}
  - {fileID: 1391849673}
  - {fileID: 1725942242}
  introLines:
  - Welcome to the top of the city. One hundred and fifty metres. Take a moment...
    just look at that view.
  - Mittens the cat is stuck on the tower across the gap. We're going to cross over
    and rescue her.
  - The wind is strong up here. When I warn you about a gust - crouch down low until
    it passes!
  finishLine: You did it! You crossed the sky and rescued Mittens. Let's light it
    up!
  baseFogDensity: 1
  onFinale:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 984879144}
