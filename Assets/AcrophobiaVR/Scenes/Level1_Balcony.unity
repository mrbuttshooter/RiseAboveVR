  m_EditorClassIdentifier: Assembly-CSharp::AcrophobiaVR.LevelController
  levelIndex: 0
  levelTitle: Level 1 - The Cafe
  startPoint: {fileID: 1930179504}
  boardPoint: {fileID: 44265591}
  objectives:
  - {fileID: 130481897}
  - {fileID: 631851704}
  - {fileID: 1087190906}
  - {fileID: 1369866412}
  - {fileID: 199629905}
  - {fileID: 1169263780}
  - {fileID: 848650564}
  - {fileID: 1802984122}
  introLines:
  - Welcome to the Sunset Cafe! We start on the balcony, six metres up - and we'll
    finish on the roof at thirteen.
  - Kiwi, the cafe's parrot, has escaped onto the window ledge. We'll need your help
    to get her back.
  - No railings out here, and you've got three lives. Your tasks are on the board
    behind you - press Esc or X to pause.
  finishLine: Ding ding! Level one complete - a ledge, a ladder and a rooftop. That
    was brave!
  baseFogDensity: 1
  onFinale:
    m_PersistentCalls:
      m_Calls: []
  finaleSeconds: 0
