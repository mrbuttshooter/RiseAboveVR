  levelIndex: 2
  levelTitle: Level 3 - The Skyscraper
  startPoint: {fileID: 1824620539}
  boardPoint: {fileID: 1110760755}
  objectives:
  - {fileID: 1157386170}
  - {fileID: 1549554281}
  - {fileID: 943281477}
  - {fileID: 1157956683}
  introLines:
  - Welcome to the top of the city. One hundred and fifty metres - and not a single
    railing. Three lives. Let's go!
  - Mittens the cat is stuck on the tower across the gap. We're going to cross over
    and rescue her.
  - The wind is strong up here. When I warn you about a gust - crouch down low until
    it passes!
  finishLine: You did it! You crossed the sky and rescued Mittens. Let's light it
    up!
  baseFogDensity: 1
  onFinale:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 496426896}
